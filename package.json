{
  "name": "linkedin-relay-mcp",
  "version": "0.0.0",
  "description": "Deep research over LinkedIn from your own account — CLI (lnrelay) + read-only MCP shim + Claude Code skill.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lnrelay": "./dist/cli.js",
    "linkedin-relay-mcp": "./dist/mcp-shim.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE", ".claude/skills/linkedin-relay/SKILL.md"],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "bun-types": "^1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
