{
  "name": "linkedin-relay-mcp",
  "version": "1.3.1",
  "description": "Deep research over LinkedIn from your own account — CLI (lnrelay) + read-only MCP server + Claude Code skill. No paid API. Reads LinkedIn's private Voyager surface with your own session cookies.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lnrelay": "./dist/cli.js",
    "linkedin-relay-mcp": "./dist/mcp-shim.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".claude/skills/linkedin-relay/SKILL.md"
  ],
  "scripts": {
    "dev": "bun run generate && bun run src/cli.ts",
    "build": "bun run generate && tsup",
    "typecheck": "bun run generate && tsc --noEmit",
    "lint": "bun run generate && biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "bun run generate && bun test",
    "check": "bun run typecheck && bun run lint && bun test",
    "generate": "bun run scripts/generate-skill.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "bun-types": "^1.3.14",
    "semantic-release": "^25.0.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "keywords": [
    "linkedin",
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "research",
    "scraper",
    "voyager",
    "cli",
    "agent"
  ],
  "author": "Tamás Gábor",
  "homepage": "https://github.com/gabros20/linkedin-relay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabros20/linkedin-relay.git"
  },
  "bugs": {
    "url": "https://github.com/gabros20/linkedin-relay/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
